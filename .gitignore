.env
downloads
.venv

# Downloaded science data (ISRO CH2 zips, NASA LROC .IMG) and generated
# pipeline outputs (posters, overlap maps, job artifacts) -- large, regenerable
# by running the pipeline, and not meant to live in version control.
data_store/
issdc_ch2_output/
outputs/

# Python
__pycache__/
*.pyc
.pytest_cache/

# The baked demo bundle IS tracked: it is what lets a deployment without
# ISSDC credentials still demonstrate the pipeline.
!demo/
# Prototype/exploration scripts -- superseded by the src/lunar_matchbench
# package, not imported by it, and one file in here carries a hardcoded
# session credential that must never be committed.
src_prot/

# Built by scripts/build_static_site.py; regenerate rather than commit.
site/
